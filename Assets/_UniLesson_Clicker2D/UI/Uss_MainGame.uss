:root{
	width: 100%;
	height: 100%;
}

.head {
	width: 100%;
	height: 10%;
	align-items: center;
}

.head.score-container {
	width: 100%;
	height: 100%;
	align-items: center;
}

.head.score-label {
	-unity-text-align: middle-center;
}

.body {
	height:80%;
}

.body.score-section {
	align-items: center;
	margin-top: 5%;
}

.body.score-container {
	width: 35%;
	height: 15%;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	/*
	background-image: url("project:/Assets/_UniLesson_Clicker2D/Textures/button_back_img.png");
	*/
}

.body.score-icon {
	width: 25%;
	height: 100%;
	background-image: url("project:/Assets/_UniLesson_Clicker2D/Textures/takara_img#takara_img_0.png");
	-unity-background-scale-mode: scale-to-fit;
}

.body.score-label {
	width: 95%;
	-unity-font-definition: url("project:/Assets/_UniLesson_Clicker2D/Fonts/pkmn_r SDF_core.asset");
	-unity-text-generator: advanced;
	-unity-text-auto-size: best-fit 23px 160px;
	-unity-text-align: lower-center;
	-unity-font-style: bold;

}

.food {
	width: 100%;
	height: 20%;
}

.foot.audio-setting-container {
	width: 100%;
	height: 100%;
	flex-direction: row;
	align-items: flex-start;
}

.foot.volume-slider {
	width: 25%;
}

.foot.register-container {
	
}